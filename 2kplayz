local AimCircle = Drawing.new("Circle")
AimCircle.Visible = false
AimCircle.Color = Color3.fromRGB(255, 255, 255)
AimCircle.Thickness = 1.5
AimCircle.Filled = false
AimCircle.NumSides = 64

local function GetClosestPlayer()
    local closest, closestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        local part = char and char:FindFirstChild(State.AimPart)
        if not part then continue end
        local screen, vis = Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local pos2d = Vector2.new(screen.X, screen.Y)
        local dist = (pos2d - center).Magnitude
        if dist < State.AimbotFOV and dist < closestDist then
            closest = part
            closestDist = dist
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    AimCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    AimCircle.Radius = State.AimbotFOV
    AimCircle.Visible = State.Aimbot

    if State.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = GetClosestPlayer()
        if target then
            local pos = Camera:WorldToViewportPoint(target.Position)
            local dir = CFrame.new(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(dir, State.AimbotSmoothing)
        end
    end
end)

