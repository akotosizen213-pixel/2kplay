local function ClearESP()
    for _, v in pairs(State.ESPObjects) do
        if v then
            for _, obj in pairs(v) do
                if obj and obj.Parent then obj:Remove() end
            end
        end
    end
    State.ESPObjects = {}
end

local function CreateESPForPlayer(player)
    if player == LocalPlayer then return end
    local objs = {}

    -- Box
    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = State.ESPColor
    Box.Thickness = 2
    Box.Filled = false
    objs.Box = Box

    -- Box Fill
    local BoxFill = Drawing.new("Square")
    BoxFill.Visible = false
    BoxFill.Color = Color3.fromRGB(255, 60, 60)
    BoxFill.Thickness = 1
    BoxFill.Filled = true
    BoxFill.Transparency = 0.85
    objs.BoxFill = BoxFill

    -- Name
    local NameTag = Drawing.new("Text")
    NameTag.Visible = false
    NameTag.Color = Color3.fromRGB(255, 255, 255)
    NameTag.Size = 14
    NameTag.Center = true
    NameTag.Outline = true
    NameTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    NameTag.Font = Drawing.Fonts.UI
    objs.Name = NameTag

    -- Distance
    local DistTag = Drawing.new("Text")
    DistTag.Visible = false
    DistTag.Color = Color3.fromRGB(200, 200, 200)
    DistTag.Size = 12
    DistTag.Center = true
    DistTag.Outline = true
    DistTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    DistTag.Font = Drawing.Fonts.UI
    objs.Dist = DistTag

    -- Health Bar (left side)
    local HPBar = Drawing.new("Square")
    HPBar.Visible = false
    HPBar.Color = Color3.fromRGB(0, 255, 80)
    HPBar.Thickness = 1
    HPBar.Filled = true
    objs.HPBar = HPBar

    local HPBg = Drawing.new("Square")
    HPBg.Visible = false
    HPBg.Color = Color3.fromRGB(30, 30, 30)
    HPBg.Thickness = 1
    HPBg.Filled = true
    objs.HPBg = HPBg

    -- Head circle
    local HeadCircle = Drawing.new("Circle")
    HeadCircle.Visible = false
    HeadCircle.Color = State.ESPColor
    HeadCircle.Thickness = 1.5
    HeadCircle.Filled = false
    HeadCircle.NumSides = 24
    objs.Head = HeadCircle

    -- Tracer line (feet to bottom of screen)
    local Tracer = Drawing.new("Line")
    Tracer.Visible = false
    Tracer.Color = State.ESPColor
    Tracer.Thickness = 1
    Tracer.Transparency = 0.5
    objs.Tracer = Tracer

    State.ESPObjects[player] = objs
end

local function RemoveESPForPlayer(player)
    if State.ESPObjects[player] then
        for _, obj in pairs(State.ESPObjects[player]) do
            if obj then obj:Remove() end
        end
        State.ESPObjects[player] = nil
    end
end

local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not State.ESPObjects[player] then
            CreateESPForPlayer(player)
        end

        local objs = State.ESPObjects[player]
        local char = player.Character
        local lchar = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not State.ESP or not root or not head or not hum or hum.Health <= 0 then
            for _, obj in pairs(objs) do obj.Visible = false end
            continue
        end

        local headPos, headVis = Camera:WorldToViewportPoint(head.Position)
        local rootPos, rootVis = Camera:WorldToViewportPoint(root.Position)
        local feetPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

        if not headVis then
            for _, obj in pairs(objs) do obj.Visible = false end
            continue
        end

        local sx, sy = headPos.X, headPos.Y
        local bx, by = feetPos.X, feetPos.Y
        local height = math.abs(by - sy)
        local width = height * 0.55
        local dist = math.floor((lchar and lchar:FindFirstChild("HumanoidRootPart") and (lchar.HumanoidRootPart.Position - root.Position).Magnitude) or 0)
        local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local headRadius = math.max(4, height * 0.12)

        -- Box fill
        objs.BoxFill.Position = Vector2.new(sx - width/2, sy)
        objs.BoxFill.Size = Vector2.new(width, height)
        objs.BoxFill.Visible = true

        -- Box outline
        objs.Box.Position = Vector2.new(sx - width/2, sy)
        objs.Box.Size = Vector2.new(width, height)
        objs.Box.Visible = true

        -- Head circle
        objs.Head.Position = Vector2.new(sx, sy - headRadius)
        objs.Head.Radius = headRadius
        objs.Head.Visible = true

        -- Name
        objs.Name.Text = player.DisplayName
        objs.Name.Position = Vector2.new(sx, sy - headRadius * 2 - 4)
        objs.Name.Visible = true

        -- Distance
        objs.Dist.Text = dist .. "m"
        objs.Dist.Position = Vector2.new(sx, by + 3)
        objs.Dist.Visible = true

        -- HP Bar
        local barX = sx - width/2 - 8
        objs.HPBg.Position = Vector2.new(barX - 2, sy)
        objs.HPBg.Size = Vector2.new(5, height)
        objs.HPBg.Visible = true
        objs.HPBar.Position = Vector2.new(barX - 2, sy + height * (1 - hpRatio))
        objs.HPBar.Size = Vector2.new(5, height * hpRatio)
        objs.HPBar.Color = Color3.fromRGB(math.floor(255 * (1 - hpRatio)), math.floor(255 * hpRatio), 30)
        objs.HPBar.Visible = true

