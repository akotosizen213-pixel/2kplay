local FlingConn
local function FlingPlayer(target)
    local tchar = target.Character
    local lchar = LocalPlayer.Character
    if not tchar or not lchar then return end
    local troot = tchar:FindFirstChild("HumanoidRootPart")
    local lroot = lchar:FindFirstChild("HumanoidRootPart")
    if not troot or not lroot then return end
    for i = 1, 10 do
        lroot.CFrame = troot.CFrame
        troot.Velocity = Vector3.new(math.random(-500, 500), 800, math.random(-500, 500))
        task.wait(0.01)
    end
end

local function FlingAll()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            task.spawn(FlingPlayer, p)
        end
    end
end

local function LoopFlingAll()
    if FlingConn then FlingConn:Disconnect() end
    if State.LoopFling then
        FlingConn = RunService.Heartbeat:Connect(function()
            FlingAll()
        end)
    end
end

